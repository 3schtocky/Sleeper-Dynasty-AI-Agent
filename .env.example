# Copy this file to .env and fill it in, or just run:
#   dynasty-agent init --username <your sleeper username>
# which writes this file for you automatically.

SLEEPER_USERNAME=
SLEEPER_USER_ID=
LEAGUE_ID=
DRAFT_ID=

# Optional: FantasyCalc dynasty value parameters. Defaults below match a
# 12-team, 1QB, full-PPR league. Uncomment and edit if yours differs.
# FANTASYCALC_NUM_QBS=1
# FANTASYCALC_NUM_TEAMS=12
# FANTASYCALC_PPR=1
